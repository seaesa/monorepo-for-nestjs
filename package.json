{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api...",
    "dev:web": "turbo run dev --filter=web... --filter=api...",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:dead": "knip",
    "check-types": "turbo run check-types",
    "format": "oxfmt",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "format:check": "oxfmt --check",
    "lint:deps": "depcruise apps/api packages -c .dependency-cruiser.cjs --ts-config apps/api/tsconfig.json && depcruise apps/web -c .dependency-cruiser.cjs --ts-config apps/web/tsconfig.json && depcruise apps/mobile -c .dependency-cruiser.cjs --ts-config apps/mobile/tsconfig.json",
    "lint:spell": "cspell --no-progress --gitignore \"**/*.{ts,tsx,md,json}\"",
    "lint:dup": "jscpd",
    "lint:pkg": "sherif",
    "check": "pnpm format:check && pnpm lint:pkg && pnpm lint:dead && pnpm lint:deps && pnpm lint:spell && pnpm lint:dup && pnpm lint && turbo run check-types test build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@cspell/dict-companies": "^3.2.14",
    "@cspell/dict-fullstack": "^3.2.9",
    "@cspell/dict-software-terms": "^5.4.9",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "cspell": "10.5.1",
    "dependency-cruiser": "18.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.11.11",
    "jscpd": "5.4.3",
    "knip": "^6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pnpm": "12.21.0",
    "sherif": "1.13.0",
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "sherif": {
    "ignoreDependency": [
      "typescript"
    ]
  }
}
