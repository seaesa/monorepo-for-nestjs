{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "pin",
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "One PR per ecosystem for non-major updates.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Expo pins its React Native ecosystem; upgrade it with `npx expo install --fix`.",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react-native",
        "react-native-*",
        "@react-native/*"
      ],
      "groupName": "expo sdk"
    },
    {
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react-native",
        "react-native-*",
        "@react-native/*"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Shared tooling packages keep ranges.",
      "matchFileNames": ["packages/**"],
      "rangeStrategy": "auto"
    }
  ]
}
