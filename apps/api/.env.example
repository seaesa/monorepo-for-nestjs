NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins (REST + WebSocket).
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
# Public origin of the web app; links in emails point here.
WEB_APP_URL=http://localhost:3001

DATABASE_URL=postgresql://app:app@localhost:5433/app?schema=public
# Connections per API/worker process. Keep replicas * this under Postgres max_connections.
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=2592000

# true = logins are rejected until the address is confirmed (needs a real mail provider).
REQUIRE_EMAIL_VERIFICATION=false
# /metrics for Prometheus. Keep it reachable only from your scraper network.
METRICS_ENABLED=true
WORKER_CONCURRENCY=5
# Expo push: only needed when enhanced push security is enabled for the project
EXPO_ACCESS_TOKEN=

# Error reporting + tracing (Sentry). Unset SENTRY_DSN = disabled.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# APP_RELEASE=<git sha or image tag>

# API_DOCS_ENABLED=true   # /docs + /openapi.json; default: off in production only
