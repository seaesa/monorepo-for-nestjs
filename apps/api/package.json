{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k -n build,api \"swc src -d dist --strip-leading-paths --watch\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "dev:worker": "node --watch --env-file-if-exists=.env dist/worker.js",
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@casl/ability": "7.1.3",
    "@casl/prisma": "^2.2.0",
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/platform-socket.io": "12.5.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/websockets": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@repo/contracts": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@scalar/nestjs-api-reference": "1.2.39",
    "@sentry/nestjs": "11.13.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.45.2",
    "bullmq": "6.7.6",
    "cookie": "2.0.2",
    "cookie-parser": "1.4.7",
    "expo-server-sdk": "8.0.0",
    "helmet": "8.3.0",
    "i18next": "catalog:",
    "ioredis": "6.0.0",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "catalog:",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "catalog:",
    "supertest": "7.3.2",
    "typescript": "catalog:"
  }
}
