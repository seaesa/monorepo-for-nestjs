{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Isomorphic API contract shared by backend and frontends: zod schemas, routes, error codes, socket events.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "jest",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/jest": "0.2.39",
    "jest": "30.5.2",
    "typescript": "catalog:"
  }
}
